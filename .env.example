# Omada API Configuration
# Copy this file to .env and fill in your actual values

# Omada Base URL (e.g., https://your-company.omada.cloud)
VITE_OMADA_BASE_URL=

# OAuth2 Configuration (Azure AD)
# Get these from your Azure AD App Registration

# Azure AD Tenant ID
VITE_TENANT_ID=

# Azure AD Client ID (Application ID)
VITE_CLIENT_ID=

# OAuth2 Scope (default: https://graph.microsoft.com/.default)
# For Omada, use your Omada API scope
VITE_OAUTH2_SCOPE=

# Redirect URI (must match Azure AD app registration)
# Default: http://localhost:5173/callback (for development)
VITE_REDIRECT_URI=http://localhost:5173/callback
